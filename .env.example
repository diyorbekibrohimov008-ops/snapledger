# Automatically provisioned on Vercel when Blob Store is linked:
BLOB_READ_WRITE_TOKEN=

# Optional: Enable live Vision LLM OCR extraction (falls back to built-in deterministic OCR parser when unset)
OPENAI_API_KEY=

# Optional: Enable live Plaid Sandbox / Production bank feed (falls back to built-in Plaid Sandbox feed when unset)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
